@{
    Layout = null;
}

<style>
    .main-container {
        display: flex;
        gap: 15px;
        padding: 0 15px 15px 15px;
    }

    .list-panel {
        flex: 1;
        min-width: 0;
    }

    .calendar-panel {
        width: 380px;
        flex-shrink: 0;
    }

    .section-title {
        font-size: 14px;
        font-weight: bold;
        padding: 8px 12px;
        background: #f8f8f8;
        border-left: 3px solid #8B0000;
        margin-bottom: 10px;
    }

    /* 日历样式 - 紧凑版 */
    .calendar-container {
        background: #fff;
        border: 1px solid #e6e6e6;
        border-radius: 4px;
        padding: 10px;
    }

    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
        padding: 6px 8px;
        background: #f8f8f8;
        border-radius: 4px;
    }

    .calendar-header .month-nav {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .calendar-header .month-title {
        font-size: 13px;
        font-weight: bold;
        min-width: 90px;
        text-align: center;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 4px;
        transition: background-color 0.2s;
    }

    .calendar-header .month-title:hover {
        background-color: #e6e6e6;
    }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 1px;
        background: #e6e6e6;
        border: 1px solid #e6e6e6;
        border-radius: 4px;
        overflow: hidden;
        font-size: 11px;
    }

    .calendar-day-header {
        background: #f2f2f2;
        padding: 5px;
        text-align: center;
        font-weight: bold;
        color: #666;
    }

    .calendar-day {
        background: #fff;
        min-height: 50px;
        padding: 2px;
        vertical-align: top;
    }

    .calendar-day.other-month {
        background: #fafafa;
        color: #ccc;
    }

    .calendar-day.today {
        background: #fff8e6;
    }

    .calendar-day .day-number {
        font-weight: bold;
        margin-bottom: 2px;
        color: #333;
        font-size: 10px;
    }

    .calendar-day.other-month .day-number {
        color: #ccc;
    }

    .calendar-event {
        font-size: 9px;
        padding: 1px 2px;
        margin-bottom: 1px;
        border-radius: 2px;
        color: #fff;
        cursor: pointer;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .calendar-event:hover {
        opacity: 0.8;
    }

    .calendar-event.status-pending {
        background: #1E9FFF;
    }

    .calendar-event.status-ongoing {
        background: #5FB878;
    }

    .calendar-event.status-ended {
        background: #999;
    }

    .calendar-legend {
        display: flex;
        gap: 10px;
        margin-top: 8px;
        padding: 5px 8px;
        background: #f8f8f8;
        border-radius: 4px;
        font-size: 11px;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 3px;
    }

    .legend-color {
        width: 10px;
        height: 10px;
        border-radius: 2px;
    }
</style>

<div class="layui-card layadmin-header">
    <div class="layui-breadcrumb" lay-filter="breadcrumb" style="visibility: visible;padding: 15px;">
        <a href="/Home/Welcome" data-ajax-update="#LAY_app_body" data-ajax="true">主页</a><span lay-separator="">/</span>
        <a><cite>我的活动</cite></a>
    </div>
</div>

<div class="main-container">
    <!-- 左侧：列表视图 -->
    <div class="list-panel">
        <div class="section-title">活动列表</div>
        <div class="demoTable" style="margin-bottom: 10px;">
            <div style="display: inline-block;">
                <span>活动标题：</span>
                <div class="layui-inline">
                    <input class="layui-input" name="activeTitle" id="activeTitle" autocomplete="off" placeholder="请输入" style="width: 120px;">
                </div>
                <span>状态：</span>
                <div class="layui-inline">
                    <select name="statusFilter" id="statusFilter" class="layui-input" style="width: 90px;">
                        <option value="">全部</option>
                        <option value="0">未开始</option>
                        <option value="1">进行中</option>
                        <option value="2">已结束</option>
                    </select>
                </div>
                <button class="layui-btn layui-btn-xs" data-type="search">搜索</button>
                <button class="layui-btn layui-btn-xs layui-btn-normal" data-type="reload">刷新</button>
            </div>
        </div>
        <table class="layui-hide" id="activeList" lay-filter="List"></table>
    </div>

    <!-- 右侧：日历视图 -->
    <div class="calendar-panel">
        <div class="section-title">活动日历</div>
        <div class="calendar-container">
            <div class="calendar-header">
                <div class="month-nav">
                    <button class="layui-btn layui-btn-xs" id="prevMonth"><i class="layui-icon layui-icon-left"></i></button>
                    <span class="month-title" id="currentMonth"></span>
                    <button class="layui-btn layui-btn-xs" id="nextMonth"><i class="layui-icon layui-icon-right"></i></button>
                </div>
                <button class="layui-btn layui-btn-xs layui-btn-normal" id="todayBtn">今天</button>
            </div>
            <div class="calendar-grid" id="calendarGrid"></div>
            <div class="calendar-legend">
                <div class="legend-item">
                    <div class="legend-color" style="background: #1E9FFF;"></div>
                    <span>未开始</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background: #5FB878;"></div>
                    <span>进行中</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background: #999;"></div>
                    <span>已结束</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    layui.use(['table', 'form', 'layer', 'laydate'], function () {
        var $ = layui.$;
        var table = layui.table;
        var form = layui.form;
        var layer = layui.layer;
        var laydate = layui.laydate;

        var currentYear = new Date().getFullYear();
        var currentMonth = new Date().getMonth() + 1;
        var calendarEvents = [];

        // 格式化日期为 yyyy-MM-dd HH:mm 格式
        function formatDateTimeMinute(dateStr) {
            if (!dateStr) return '';
            var date = new Date(dateStr);
            if (isNaN(date.getTime())) return '';
            var year = date.getFullYear();
            var month = ('0' + (date.getMonth() + 1)).slice(-2);
            var day = ('0' + date.getDate()).slice(-2);
            var hours = ('0' + date.getHours()).slice(-2);
            var minutes = ('0' + date.getMinutes()).slice(-2);
            return year + '-' + month + '-' + day + ' ' + hours + ':' + minutes;
        }

        function initListView() {
            table.render({
                id: 'List',
                elem: '#activeList',
                url: '/ClubHub/Member/GetMyActiveList',
                cols: [[
                    {field: 'title', title: '活动标题', width: 140, align: 'center'},
                    {field: 'place', title: '地点', width: 100, align: 'center'},
                    {field: 'clubName', title: '社团', width: 150, align: 'center'},
                    {
                        field: 'startTime', title: '开始时间', width: 180, align: 'center', templet: function (res) {
                            return res.startTime ? formatDateTimeMinute(res.startTime) : '';
                        }
                    },
                    {
                        field: 'status', title: '状态', width: 105, align: 'center', templet: function (d) {
                            var now = new Date();
                            var startTime = d.startTime ? new Date(d.startTime) : null;
                            var endTime = d.endTime ? new Date(d.endTime) : null;
                            if (endTime && now > endTime) {
                                return '<span class="layui-badge layui-bg-gray">已结束</span>';
                            } else if (startTime && now >= startTime) {
                                return '<span class="layui-badge layui-bg-green">进行中</span>';
                            } else {
                                return '<span class="layui-badge layui-bg-blue">未开始</span>';
                            }
                        }
                    },
                    {
                        field: 'signType', title: '参与', width: 105, align: 'center', templet: function (d) {
                            if (d.signType == 1) return '<span class="layui-badge layui-bg-blue">已报名</span>';
                            if (d.signType == 2) return '<span class="layui-badge layui-bg-green">已参加</span>';
                            if (d.signType == 3) return '<span class="layui-badge layui-bg-gray">未参加</span>';
                            return '';
                        }
                    }
                ]],
                page: true,
                limit: 10,
                limits: [5, 10, 15, 20]
            });
        }

        initListView();
        form.render('select');

        var active = {
            search: function () {
                table.reload('List', {
                    page: {curr: 1},
                    where: {
                        Title: $('#activeTitle').val(),
                        status: $('#statusFilter').val() || null
                    }
                });
            },
            reload: function () {
                $('#activeTitle').val('');
                $('#statusFilter').val('');
                form.render('select');
                table.reload('List', {
                    page: {curr: 1},
                    where: {Title: '', status: null}
                });
            }
        };

        $('.demoTable .layui-btn').on('click', function () {
            var type = $(this).data('type');
            active[type] ? active[type].call(this) : '';
        });

        $('#prevMonth').on('click', function () {
            currentMonth--;
            if (currentMonth < 1) {
                currentMonth = 12;
                currentYear--;
            }
            renderCalendar();
        });

        $('#nextMonth').on('click', function () {
            currentMonth++;
            if (currentMonth > 12) {
                currentMonth = 1;
                currentYear++;
            }
            renderCalendar();
        });

        $('#todayBtn').on('click', function () {
            currentYear = new Date().getFullYear();
            currentMonth = new Date().getMonth() + 1;
            renderCalendar();
        });

        // 点击年月标题弹出年月选择器
        $('#currentMonth').on('click', function () {
            var that = $(this);
            
            // 创建年月选择器
            laydate.render({
                elem: that[0],
                type: 'month',
                format: 'yyyy年M月',
                value: currentYear + '年' + currentMonth + '月',
                show: true,
                position: 'fixed',
                trigger: 'click',
                done: function (value, date) {
                    currentYear = date.year;
                    currentMonth = date.month;
                    renderCalendar();
                }
            });
        });

        function renderCalendar() {
            $('#currentMonth').text(currentYear + '年' + currentMonth + '月');
            $.get('/ClubHub/Member/GetMyActiveCalendar', {year: currentYear, month: currentMonth}, function (res) {
                if (res.code === 0) {
                    calendarEvents = res.data || [];
                    drawCalendar();
                }
            });
        }

        function drawCalendar() {
            var grid = $('#calendarGrid');
            grid.empty();

            var weekDays = ['日', '一', '二', '三', '四', '五', '六'];
            weekDays.forEach(function (day) {
                grid.append('<div class="calendar-day-header">' + day + '</div>');
            });

            var firstDay = new Date(currentYear, currentMonth - 1, 1);
            var lastDay = new Date(currentYear, currentMonth, 0);
            var startDayOfWeek = firstDay.getDay();
            var daysInMonth = lastDay.getDate();
            var prevMonthLastDay = new Date(currentYear, currentMonth - 1, 0).getDate();

            var today = new Date();
            var todayStr = today.getFullYear() + '-' + String(today.getMonth() + 1).padStart(2, '0') + '-' + String(today.getDate()).padStart(2, '0');

            for (var i = startDayOfWeek - 1; i >= 0; i--) {
                var day = prevMonthLastDay - i;
                grid.append('<div class="calendar-day other-month"><div class="day-number">' + day + '</div></div>');
            }

            for (var d = 1; d <= daysInMonth; d++) {
                var dateStr = currentYear + '-' + String(currentMonth).padStart(2, '0') + '-' + String(d).padStart(2, '0');
                var isToday = dateStr === todayStr;
                var dayClass = 'calendar-day' + (isToday ? ' today' : '');

                var dayHtml = '<div class="' + dayClass + '" data-date="' + dateStr + '">';
                dayHtml += '<div class="day-number">' + d + '</div>';

                var dayEvents = getEventsForDate(dateStr);
                var displayCount = Math.min(dayEvents.length, 2);
                for (var e = 0; e < displayCount; e++) {
                    var event = dayEvents[e];
                    var statusClass = getEventStatusClass(event);
                    dayHtml += '<div class="calendar-event ' + statusClass + '" data-id="' + event.id + '" title="' + event.title + '">' + event.title + '</div>';
                }
                if (dayEvents.length > 2) {
                    dayHtml += '<div style="font-size:9px;color:#999;text-align:center;">+' + (dayEvents.length - 2) + '</div>';
                }

                dayHtml += '</div>';
                grid.append(dayHtml);
            }

            var totalCells = startDayOfWeek + daysInMonth;
            var remainingCells = (7 - (totalCells % 7)) % 7;
            for (var n = 1; n <= remainingCells; n++) {
                grid.append('<div class="calendar-day other-month"><div class="day-number">' + n + '</div></div>');
            }

            $('.calendar-event').on('click', function () {
                var eventId = $(this).data('id');
                var event = calendarEvents.find(function (e) {
                    return e.id == eventId;
                });
                if (event) showEventDetail(event);
            });
        }

        function getEventsForDate(dateStr) {
            return calendarEvents.filter(function (event) {
                var startDate = event.start.split(' ')[0];
                var endDate = event.end.split(' ')[0];
                return dateStr >= startDate && dateStr <= endDate;
            });
        }

        function getEventStatusClass(event) {
            var now = new Date();
            var startTime = new Date(event.start.replace(/-/g, '/'));
            var endTime = new Date(event.end.replace(/-/g, '/'));
            if (now > endTime) return 'status-ended';
            if (now >= startTime) return 'status-ongoing';
            return 'status-pending';
        }

        function showEventDetail(event) {
            var signTypeText = '';
            if (event.signType == 1) signTypeText = '<span class="layui-badge layui-bg-blue">已报名</span>';
            else if (event.signType == 2) signTypeText = '<span class="layui-badge layui-bg-green">已参加</span>';
            else if (event.signType == 3) signTypeText = '<span class="layui-badge layui-bg-gray">未参加</span>';

            var content = '<div style="padding: 15px;">';
            content += '<h3 style="margin-bottom: 10px; color: #333;">' + event.title + '</h3>';
            content += '<p style="margin: 6px 0;"><strong>社团：</strong>' + (event.clubName || '-') + '</p>';
            content += '<p style="margin: 6px 0;"><strong>地点：</strong>' + (event.place || '-') + '</p>';
            content += '<p style="margin: 6px 0;"><strong>开始：</strong>' + event.start + '</p>';
            content += '<p style="margin: 6px 0;"><strong>结束：</strong>' + event.end + '</p>';
            content += '<p style="margin: 6px 0;"><strong>状态：</strong>' + signTypeText + '</p>';
            if (event.content) {
                content += '<p style="margin: 6px 0;"><strong>内容：</strong></p>';
                content += '<p style="padding: 6px; background: #f8f8f8; border-radius: 4px; font-size: 12px;">' + event.content + '</p>';
            }
            content += '</div>';

            layer.open({
                type: 1,
                title: '活动详情',
                area: ['350px', '320px'],
                content: content
            });
        }

        renderCalendar();
    });
</script>
