@{
    Layout = null;
}
@model ClubHub.Areas.ClubHub.Models.AdminInfoViewModel

@*列表页头部*@
<div class="layui-card layadmin-header">
    <div class="layui-breadcrumb" lay-filter="breadcrumb" style="visibility: visible;padding: 15px;">
        <a href="/Home/Welcome" data-ajax-update="#LAY_app_body" data-ajax="true">主页</a><span lay-separator="">/</span>
        <a><cite>个人信息</cite></a>
    </div>
</div>

@*个人信息表单 - 拟物风格设计*@
<style>
    /* 页面容器 */
    .profile-container {
        padding: 30px 20px;
        min-height: calc(100vh - 60px);
    }

    /* 表单卡片容器 */
    .form-card {
        max-width: 600px;
        margin: 0 auto;
        background: linear-gradient(145deg, #ffffff 0%, #fafafa 100%);
        border-radius: 16px;
        box-shadow: 
            0 4px 6px rgba(0,0,0,0.02),
            0 10px 20px rgba(0,0,0,0.04),
            0 20px 40px rgba(0,0,0,0.06),
            inset 0 1px 0 rgba(255,255,255,1);
        overflow: hidden;
        position: relative;
    }

    /* 表单卡片装饰边框 */
    .form-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #8B0000 0%, #a52a2a 50%, #8B0000 100%);
    }

    /* 表单头部 */
    .form-header {
        padding: 30px 35px 20px;
        text-align: center;
        border-bottom: 1px solid #f0f0f0;
    }

    .form-avatar {
        width: 80px;
        height: 80px;
        margin: 0 auto 15px;
        background: linear-gradient(135deg, #8B0000 0%, #a52a2a 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        color: #fff;
        box-shadow: 0 4px 15px rgba(139, 1, 1, 0.3);
    }

    .form-title {
        font-size: 22px;
        font-weight: 600;
        color: #333;
        margin: 0 0 5px;
    }

    .form-subtitle {
        font-size: 13px;
        color: #888;
    }

    /* 表单内容区域 */
    .form-body {
        padding: 30px 35px;
    }

    /* 分区标题 */
    .section-header {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid #f5f5f5;
    }

    .section-dot {
        width: 8px;
        height: 8px;
        background: #8B0000;
        border-radius: 50%;
        margin-right: 10px;
    }

    .section-name {
        font-size: 14px;
        font-weight: 600;
        color: #555;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* 表单项样式 */
    .info-form .layui-form-item {
        margin-bottom: 18px;
    }

    .info-form .layui-form-label {
        width: 100px;
        padding: 10px 0;
        font-weight: 500;
        color: #555;
        font-size: 14px;
    }

    .info-form .layui-input-block {
        margin-left: 120px;
        min-height: 40px;
    }

    /* 输入框样式 - 拟物化 */
    .info-form .layui-input {
        height: 40px;
        line-height: 40px;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
        box-shadow: 
            inset 0 2px 4px rgba(0,0,0,0.03),
            0 1px 0 rgba(255,255,255,1);
        transition: all 0.25s ease;
        font-size: 14px;
        padding: 0 12px;
    }

    .info-form .layui-input:hover {
        border-color: #c0c0c0;
        box-shadow: 
            inset 0 2px 4px rgba(0,0,0,0.03),
            0 0 0 3px rgba(139, 1, 1, 0.08);
    }

    .info-form .layui-input:focus {
        border-color: #8B0000;
        box-shadow: 
            inset 0 2px 4px rgba(0,0,0,0.03),
            0 0 0 3px rgba(139, 1, 1, 0.12);
    }

    /* 只读输入框 - 禁用状态 */
    .info-form .layui-input[readonly] {
        background: linear-gradient(180deg, #f5f5f5 0%, #eeeeee 100%);
        border-color: #e0e0e0;
        color: #777;
        cursor: not-allowed;
        box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);
    }

    /* 可编辑区域高亮 */
    .editable-area {
        background: linear-gradient(135deg, #fff8f8 0%, #fff0f0 100%);
        border: 1px solid #f0d0d0;
        border-radius: 12px;
        padding: 25px;
        margin-top: 25px;
        position: relative;
    }

    .editable-badge {
        position: absolute;
        top: -12px;
        right: 20px;
        background: linear-gradient(135deg, #8B0000 0%, #a52a2a 100%);
        color: #fff;
        padding: 4px 14px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 500;
        box-shadow: 0 2px 8px rgba(139, 1, 1, 0.3);
    }

    /* 提交按钮区域 */
    .form-footer {
        padding: 25px 35px 35px;
        text-align: center;
        background: linear-gradient(180deg, #fafafa 0%, #f5f5f5 100%);
        border-top: 1px solid #f0f0f0;
    }

    .submit-btn {
        background: linear-gradient(135deg, #8B0000 0%, #a52a2a 100%);
        border: none;
        padding: 0 45px;
        height: 44px;
        line-height: 44px;
        border-radius: 22px;
        font-size: 15px;
        font-weight: 500;
        color: #fff;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(139, 1, 1, 0.35);
        transition: all 0.3s ease;
    }

    .submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(139, 1, 1, 0.45);
    }

    .submit-btn:active {
        transform: translateY(0);
    }

    /* 提示文字 */
    .form-hint {
        margin-top: 12px;
        font-size: 12px;
        color: #999;
    }

    /* 信息标签 */
    .info-tag {
        display: inline-block;
        background: #f0f0f0;
        padding: 2px 10px;
        border-radius: 4px;
        font-size: 12px;
        color: #666;
        margin-left: 8px;
    }

    /* 响应式 */
    @@media (max-width: 768px) {
        .form-card {
            margin: 0 10px;
        }

        .form-header,
        .form-body,
        .form-footer {
            padding-left: 20px;
            padding-right: 20px;
        }

        .info-form .layui-form-label {
            width: 100%;
            text-align: left;
            padding-bottom: 5px;
        }

        .info-form .layui-input-block {
            margin-left: 0;
        }

        .editable-area {
            padding: 20px 15px;
        }
    }
</style>

<div class="profile-container">
    <div class="form-card">
        @*表单头部*@
        <div class="form-header">
            <div class="form-avatar">👤</div>
            <h2 class="form-title">个人信息</h2>
            <p class="form-subtitle">查看并更新您的账户信息</p>
        </div>

        @*表单内容*@
        <div class="form-body">
            <form class="layui-form info-form" action="">
                @*基本信息区域*@
                <div class="section-header">
                    <div class="section-dot"></div>
                    <span class="section-name">基本信息</span>
                </div>

                <div class="layui-form-item">
                    <label class="layui-form-label">学号</label>
                    <div class="layui-input-block">
                        <input type="text" name="studentId" id="studentId" class="layui-input" value="@Model?.StudentId" readonly>
                    </div>
                </div>

                <div class="layui-form-item">
                    <label class="layui-form-label">姓名</label>
                    <div class="layui-input-block">
                        <input type="text" name="name" id="name" class="layui-input" value="@Model?.Name" readonly>
                    </div>
                </div>

                <div class="layui-form-item">
                    <label class="layui-form-label">性别</label>
                    <div class="layui-input-block">
                        <input type="text" name="sexDisplay" id="sexDisplay" class="layui-input" value="@(Model?.Sex == 1 ? "男" : Model?.Sex == 2 ? "女" : "未知")" readonly>
                    </div>
                </div>

                <div class="layui-form-item">
                    <label class="layui-form-label">身份类别</label>
                    <div class="layui-input-block">
                        <input type="text" name="adminTypeDisplay" id="adminTypeDisplay" class="layui-input" value="@(Model?.AdminType == 0 ? "系统管理员" : "社团社长")" readonly>
                    </div>
                </div>

                @if (Model?.AdminType == 1)
                {
                    <div class="layui-form-item">
                        <label class="layui-form-label">所属社团</label>
                        <div class="layui-input-block">
                            <input type="text" name="clubName" id="clubName" class="layui-input" value="@Model?.ClubName" readonly>
                        </div>
                    </div>
                }

                <div class="layui-form-item">
                    <label class="layui-form-label">注册日期</label>
                    <div class="layui-input-block">
                        <input type="text" name="enterData" id="enterData" class="layui-input" value="@Model?.EnterData.ToString("yyyy-MM-dd")" readonly>
                    </div>
                </div>

                @*可编辑区域*@
                <div class="editable-area">
                    <span class="editable-badge">✎ 可编辑</span>
                    
                    <div class="section-header" style="margin-top: 5px;">
                        <div class="section-dot"></div>
                        <span class="section-name">信息维护</span>
                    </div>

                    <div class="layui-form-item">
                        <label class="layui-form-label">手机号码</label>
                        <div class="layui-input-block">
                            <input type="text" name="phoneNumber" id="phoneNumber" 
                                   placeholder="请输入您的手机号码" 
                                   autocomplete="off" 
                                   class="layui-input" 
                                   value="@Model?.PhoneNumber" 
                                   maxlength="11">
                        </div>
                    </div>

                    <div class="layui-form-item">
                        <label class="layui-form-label">登录密码</label>
                        <div class="layui-input-block">
                            <input type="password" name="password" id="password" 
                                   placeholder="请输入新密码（不修改请留空）" 
                                   autocomplete="off" 
                                   class="layui-input" 
                                   value="">
                        </div>
                    </div>
                </div>
            </form>
        </div>

        @*表单底部*@
        <div class="form-footer">
            <button class="layui-btn submit-btn" lay-submit lay-filter="formDemo">
                💾 保存修改
            </button>
            <p class="form-hint">灰色区域为系统信息，不可修改</p>
        </div>
    </div>
</div>

<script>
    layui.use('form', function () {
        var form = layui.form;
        var $ = layui.$;

        form.render();

        //监听提交
        form.on('submit(formDemo)', function (data) {
            var phoneNumber = data.field.phoneNumber;
            var password = data.field.password;

            // 验证手机号格式（如果填写了）
            if (phoneNumber && !/^1[3-9]\d{9}$/.test(phoneNumber)) {
                layer.msg('请输入正确的手机号格式', {icon: 5, time: 2000});
                return false;
            }

            $.ajax({
                type: "POST",
                url: '/ClubHub/Admin/UpdateInfo',
                data: {
                    phoneNumber: phoneNumber,
                    password: password
                },
                dataType: "json",
                success: function (response) {
                    var isSuccess = (response && (response.Msg || response.msg));
                    var message = response ? (response.Message || response.message || "操作成功") : "操作失败";

                    if (isSuccess) {
                        layer.msg(message, {icon: 6, time: 2000, shade: 0.08});
                    } else {
                        layer.msg(message, {icon: 5, time: 3000, shade: 0.08});
                    }
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    var errorMsg = "请求失败";
                    if (XMLHttpRequest.responseText) {
                        try {
                            var errorResponse = JSON.parse(XMLHttpRequest.responseText);
                            errorMsg = errorResponse.Message || errorResponse.message || errorMsg;
                        } catch (e) {
                            errorMsg = XMLHttpRequest.responseText.substring(0, 100);
                        }
                    }
                    layer.msg(errorMsg, {icon: 5, time: 3000, shade: 0.08});
                }
            });
            return false;
        });
    });
</script>
