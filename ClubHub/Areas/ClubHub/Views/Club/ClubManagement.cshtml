@{
    Layout = null;
}
@model Repository.DbEntity.T_Club

<div class="layui-card layadmin-header">
    <div class="layui-breadcrumb" lay-filter="breadcrumb" style="visibility: visible;padding: 15px;">
        <a href="/Home/Welcome" data-ajax-update="#LAY_app_body" data-ajax="true">主页</a><span lay-separator="">/</span>
        <a><cite>社团管理</cite></a><span lay-separator="">/</span>
        <a><cite>社团信息管理</cite></a>
    </div>
</div>

<div class="layui-fluid">
    <div class="layui-card">
        <div class="layui-card-header">社团信息</div>
        <div class="layui-card-body" style="padding: 15px;">
            <form class="layui-form" action="" lay-filter="club-info-form">
                <input type="hidden" name="Id" value="@Model?.Id"/>
                <div class="layui-form-item">
                    <label class="layui-form-label">社团名称</label>
                    <div class="layui-input-block">
                        <input type="text" name="Name" value="@Model?.Name" class="layui-input layui-disabled" disabled>
                    </div>
                </div>
                <div class="layui-form-item layui-form-text">
                    <label class="layui-form-label">社团说明</label>
                    <div class="layui-input-block">
                        <textarea name="Description" placeholder="请输入内容" class="layui-textarea">@Model?.Description</textarea>
                    </div>
                </div>
                <div class="layui-form-item">
                    <div class="layui-input-block">
                        <button class="layui-btn" lay-submit lay-filter="submitForm">确认修改</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    layui.use(['form', 'layer'], function () {
        var form = layui.form;
        var layer = layui.layer;
        var $ = layui.$;

        //监听提交
        form.on('submit(submitForm)', function (data) {
            var postData = data.field;
            postData.Id = '@Model?.Id';
            postData.Name = '@Model?.Name';

            $.ajax({
                url: '/ClubHub/Club/Edit',
                type: 'post',
                data: postData,
                dataType: 'json',
                success: function (res) {
                    // 兼容大小写
                    if (res.code === 0 || res.msg === true || res.Msg === true) {
                        layer.msg('修改成功', {icon: 1});
                    } else {
                        layer.msg(res.message || res.Message || '修改失败', {icon: 2});
                    }
                },
                error: function () {
                    layer.msg('请求异常', {icon: 2});
                }
            });
            return false;
        });
    });
</script>
