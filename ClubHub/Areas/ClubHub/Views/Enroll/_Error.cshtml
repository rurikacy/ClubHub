@{
    Layout = null;
}

<div style="padding: 50px; text-align: center;">
    <div class="layui-card">
        <div class="layui-card-body">
            <i class="layui-icon layui-icon-close" style="font-size: 60px; color: #FF5722;"></i>
            <h2 style="margin-top: 20px;">访问受限</h2>
            <p style="margin-top: 10px; color: #666;">@ViewBag.ErrorMessage</p>
            <button class="layui-btn layui-btn-primary" onclick="history.back()" style="margin-top: 20px;">返回</button>
        </div>
    </div>
</div>
